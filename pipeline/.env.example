# 이 파일을 복사해서 pipeline/.env 로 저장한 뒤 값을 채우세요. .env 는 절대 커밋하지 마세요.

# Supabase 프로젝트 설정 → API 에서 확인. service_role 키는 서버/로컬 스크립트 전용 (앱에 넣지 말 것)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 (콘텐츠 파이프라인) — 슈카월드 프로젝트와 같은 Groq 무료 키 사용 가능
GROQ_API_KEY=
GROQ_MODEL_ARTICLES=openai/gpt-oss-120b

# DB 마이그레이션용 (npm run db:push). Dashboard → Connect → Session pooler 문자열
SUPABASE_DB_URL=
