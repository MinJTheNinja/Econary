{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "cwd": "apps/mobile",
      "port": 8081
    },
    {
      "name": "mobile-native",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--dev-client",
        "--port",
        "8082"
      ],
      "cwd": "apps/mobile",
      "port": 8082,
      "autoPort": false
    },
    {
      "name": "site",
      "runtimeExecutable": "C:\\Users\\minjo\\AppData\\Local\\Python\\pythoncore-3.14-64\\python.exe",
      "runtimeArgs": ["-m", "http.server", "8090", "--directory", "site"],
      "port": 8090
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@tesat/admin"
      ],
      "port": 3001
    }
  ]
}
